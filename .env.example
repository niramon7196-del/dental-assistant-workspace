# Server-side only. NEVER commit a real key or expose it with a VITE_ prefix.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: per-request timeout for Gemini calls in milliseconds (default 25000)
# GEMINI_TIMEOUT_MS=25000

# Optional: public URL of the deployed app (used for links)
APP_URL="MY_APP_URL"

# Firebase AI Logic + App Check (Hybrid AI). Values from Firebase console -> Project settings -> Your apps.
# These are client-side config values, but keep real ones in .env.local (git-ignored).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional production attestation (reCAPTCHA Enterprise site key)
# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Debug App Check in a built bundle (dev server enables it automatically). Never on a public host.
# VITE_APPCHECK_DEBUG=true
